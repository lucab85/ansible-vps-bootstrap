POSTGRES_USER=appuser
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=postgres

JWT_SECRET=replace-me
COOKIE_SECRET=replace-me

N8N_ENCRYPTION_KEY=replace-me
N8N_HOST=n8n.openempower.com
WEBHOOK_URL=https://n8n.openempower.com/
GENERIC_TIMEZONE=Europe/Rome

STORE_CORS=https://shop.techmeout.it
ADMIN_CORS=https://admin.techmeout.it
AUTH_CORS=https://shop.techmeout.it,https://admin.techmeout.it

MEDUSA_BACKEND_URL=https://admin.techmeout.it
STOREFRONT_URL=https://shop.techmeout.it
MEDUSA_PUBLISHABLE_KEY=replace-after-seed

POSTGRES_EXPORTER_PASSWORD=replace-me
GRAFANA_ADMIN_PASSWORD=replace-me
GRAFANA_ROOT_URL=https://monitor.openempower.com

# Per-tenant vars — one block per store, see compose/NEW_TENANT.md
PUNTOFESTE_JWT_SECRET=replace-me
PUNTOFESTE_COOKIE_SECRET=replace-me
PUNTOFESTE_BACKEND_URL=https://admin-puntofeste.techmeout.it
PUNTOFESTE_STOREFRONT_URL=https://puntofeste.techmeout.it
PUNTOFESTE_PUBLISHABLE_KEY=replace-after-seed

SMOOTHCLOTHINGBRAND_JWT_SECRET=replace-me
SMOOTHCLOTHINGBRAND_COOKIE_SECRET=replace-me
SMOOTHCLOTHINGBRAND_BACKEND_URL=https://admin-smoothclothingbrand.techmeout.it
SMOOTHCLOTHINGBRAND_STOREFRONT_URL=https://smoothclothingbrand.techmeout.it
SMOOTHCLOTHINGBRAND_PUBLISHABLE_KEY=replace-after-seed

# Postiz (social media scheduling) - see the `postiz`/`temporal` service
# comments in docker-compose.yml for why Temporal runs without Elasticsearch
# and why both reuse this stack's shared Postgres/Redis instead of their own.
POSTIZ_JWT_SECRET=replace-me

# open-seo - single container, SQLite-backed, no Postgres/Redis needed.
# DATAFORSEO_API_KEY is a real paid account (yours, not generated) - the
# service is prepared but left un-started in docker-compose.yml until this
# is set. OPEN_SEO_BASIC_AUTH_HASH is a bcrypt hash (`caddy hash-password`)
# for the basic_auth block on its Caddyfile route - it has no auth of its
# own (AUTH_MODE=local_noauth), so this is the only thing standing between
# the public internet and the app.
DATAFORSEO_API_KEY=replace-me
OPEN_SEO_BASIC_AUTH_HASH=replace-me

# open-seo - optional Google Search Console integration (docs/SELF_HOSTING_
# GOOGLE_SEARCH_CONSOLE.md inside the container). The OAuth client's
# Authorized redirect URI in Google Cloud Console must exactly equal
# https://seo.openempower.com/api/gsc/oauth/callback. BETTER_AUTH_SECRET
# only encrypts the stored OAuth tokens here - AUTH_MODE stays local_noauth,
# this isn't Better Auth's own hosted-mode login.
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
BETTER_AUTH_SECRET=replace-me

# n8n workflow secrets — read via {{ $env.X }} inside specific workflow
# nodes (HTTP Request headers), not n8n credential objects. See
# lucab85/n8n-workflows for which workflow uses which.
GITHUB_TOKEN=replace-me
CONVERTKIT_API_SECRET=replace-me
APIFY_TOKEN=replace-me
OPENAI_API_KEY=replace-me

# claude-bridge — bearer token the bridge itself expects on incoming
# requests (distinct from the Claude Code OAuth session it proxies to,
# which comes from the host's ~/.claude, not from here).
CLAUDE_BRIDGE_KEY=replace-me
